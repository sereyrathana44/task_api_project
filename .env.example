# ចម្លងឯកសារនេះទៅជា ".env" ហើយបំពេញតម្លៃពិតរបស់អ្នក
# NEVER commit the real ".env" file to Git.

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ទុកទទេនៅ local (វានឹងប្រើ SQLite ដោយស្វ័យប្រវត្តិ)
# នៅលើ Render/Heroku, DATABASE_URL ត្រូវបានផ្តល់ជាមួយ PostgreSQL add-on ដោយស្វ័យប្រវត្តិ
DATABASE_URL=

CORS_ALLOW_ALL_ORIGINS=True
SECURE_SSL_REDIRECT=False
